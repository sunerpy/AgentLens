{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "separate-pull-requests": false,
  "skip-github-release": true,
  "pull-request-title-pattern": "chore: release ${branch}",
  "group-pull-request-title-pattern": "chore(release): 发布 ${version}",
  "pull-request-header": "本 PR 由 release-please 维护：合并后 .github/workflows/release.yml 会自己建 tag 与 draft Release，三平台产物齐全才公开。",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "changelog/CHANGELOG-v0.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(['agentlens-core','agentlens-tauri','agentlens-collector','agentlens-askpass'].includes(@.name.value))].version"
        },
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "refactor",
          "section": "Refactoring"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "test",
          "section": "Tests"
        },
        {
          "type": "build",
          "section": "Build System"
        },
        {
          "type": "ci",
          "section": "CI"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "style",
          "section": "Styling",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": true
        }
      ]
    }
  }
}
