{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentLens",
  "identifier": "top.onethinker.agentlens",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentLens",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sunerpy/AgentLens/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4ODVFN0UzREIxMzY5OTcKUldTWGFSUGI0K2VGMk9JZjlZYnhGM1dTR1ROeVV5NVZGNHF1ZEk5TnpCVmwvRHZBbytUWXo0ODEK"
    }
  }
}
